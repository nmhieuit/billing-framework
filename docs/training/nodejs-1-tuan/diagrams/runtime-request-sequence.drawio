<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram name="1. Một request GET /wallet" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-2" value="&lt;b&gt;GET /wallet: luồng runtime của MỘT request (wallet, mức tổng quát)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="p1-3" value="Chạy trên một luồng JS. Số thứ tự mũi tên khớp bảng &quot;Số mũi tên → hàm → file:dòng&quot; ở cuối trang. Trình tự bên trong NestJS (middleware → guard → controller) lấy từ lab &lt;i&gt;labs/get-wallet-http-trace.ts&lt;/i&gt; [ĐÃ CHẠY], chưa đọc source NestJS." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1100" height="40" as="geometry"/></mxCell><mxCell id="p1-4" value="&lt;b&gt;Client / Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gửi HTTP&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="150" height="1150" as="geometry"/></mxCell><mxCell id="p1-5" value="&lt;b&gt;Nest + Fastify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;framework · router, đóng gói JSON&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex=