                <mxCell id="p2-29" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Client B: gửi request thứ hai khi A chưa xong; không bị chặn bởi A." vertex="1">
