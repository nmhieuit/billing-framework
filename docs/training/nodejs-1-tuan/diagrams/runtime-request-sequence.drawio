                </mxCell>
                <mxCell id="p2-31" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Code của repo (xem trang 1). Mỗi request có ngữ cảnh AsyncLocalStorage, transaction và đối tượng repository RIÊNG." vertex="1">
                    <mxGeometry height="120" width="170" x="615" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p2-32" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Kysely MssqlDialect + tarn: min 0, tối đa &lt;b&gt;10&lt;/b&gt; kết nối (database/connection.ts:16)." vertex="1">
                    <mxGeometry height="120" width="170" x="845" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p2-33" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Xử lý hai transaction song song trên hai kết nối." vertex="1">
                    <mxGeometry height="120" width="170" x="1045" y="1020" as="geometry"/>
                </mxCell>
                <mxCell id="p2-34" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Một luồng JS&lt;/b&gt;&lt;br&gt;Phần đồng bộ của B không chạy khi A đang chạy đồng bộ. B chỉ được chạy khi A gặp &lt;i&gt;await&lt;/i&gt; và nhường. Lab: cả A và B vào guard trong 1ms, vào BEGIN trong 1ms, rồi chờ I/O song song." vertex="1">
                    <mxGeometry height="120" width="340" x="1320" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="p2-35" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;Lab [ĐÃ CHẠY]: hai request chồng nhau xong trong ~65ms, bằng một request tuần tự (~60ms DB giả), không phải ~120ms." vertex="1">
                    <mxGeometry height="80" width="340" x="1320" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="p2-36" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Ngữ cảnh riêng từng request&lt;/b&gt;&lt;br&gt;Lab: log của A luôn mang correlation &lt;b&gt;aaaaaaaa&lt;/b&gt;, của B luôn &lt;b&gt;bbbbbbbb&lt;/b&gt;, dù xen kẽ qua mọi await (AsyncLocalStorage, observability/correlation.ts:7)." vertex="1">
                    <mxGeometry height="90" width="340" x="1320" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="p2-37" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Pool kết nối&lt;/b&gt;&lt;br&gt;tarn: min 0, max = &lt;i&gt;config.poolMax ?? 10&lt;/i&gt; (packages/database/src/connection.ts:16). &lt;i&gt;poolMax&lt;/i&gt; chỉ được đặt trong test (perf, chaos); service dùng mặc định: tests/chaos/support/service-config.test.ts:28 (&quot;poolMax không có biến môi trường&quot;) ⇒ tối đa &lt;b&gt;10&lt;/b&gt; kết nối. Comment repo tests/perf/support/perf-env.ts:167-168: vượt poolMax thì &quot;thời gian chờ pool bị tính vào độ trễ&quot; ⇒ request thứ 11 đồng thời phải &lt;b&gt;chờ&lt;/b&gt; kết nối rảnh. &lt;b&gt;[GIẢ THUYẾT]&lt;/b&gt; timeout của tarn chưa đọc, chưa chạy với SQL Server thật." vertex="1">
                    <mxGeometry height="190" width="340" x="1320" y="420" as="geometry"/>
                </mxCell>
                <mxCell id="p2-38" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Khóa&lt;/b&gt;&lt;br&gt;GET /wallet chỉ SELECT, không updlock (account.repository.ts:16-23) ⇒ ứng dụng không giữ khóa; mỗi request vẫn mở transaction riêng (unit-of-work.ts:24). Nếu một thao tác GHI cùng ví đang giữ khóa, SELECT có thể phải chờ tùy mức cô lập. &lt;b&gt;[GIẢ THUYẾT]&lt;/b&gt; mức cô lập SQL Server chưa tìm thấy trong code." vertex="1">
                    <mxGeometry height="150" width="340" x="1320" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="p2-39" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="&lt;b&gt;Idempotency&lt;/b&gt;&lt;br&gt;GET không dùng idempotency key; hai request giống nhau chạy độc lập. (Idempotency chỉ áp dụng cho endpoint ghi, ví dụ POST /topups.)" vertex="1">
                    <mxGeometry height="90" width="340" x="1320" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="p2-40" parent="1" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;" value="&lt;b&gt;Vết chạy lab (rút gọn)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;+207ms A guard · +208ms B guard&lt;br&gt;+208ms A GetWallet, A BEGIN&lt;br&gt;+208ms B GetWallet, B BEGIN&lt;br&gt;+229ms A SELECT · +229ms B SELECT&lt;br&gt;+269ms A COMMIT → +270ms A 200&lt;br&gt;+270ms B COMMIT → +271ms B 200&lt;/font&gt;" vertex="1">
