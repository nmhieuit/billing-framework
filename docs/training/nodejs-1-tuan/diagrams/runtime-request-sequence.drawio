arent="1"><mxGeometry x="1319" y="714" width="12" height="136" as="geometry"/></mxCell><mxCell id="p1-33" value="9. await · SELECT * FROM t_&lt;tenant&gt;.accounts WHERE id=?" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-18" relative="1" as="geometry"><mxPoint x="1331" y="770" as="sourcePoint"/><mxPoint x="1494" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-34" value="10. hàng dữ liệu (tiếp tục sau await)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint x="1494" y="820" as="sourcePoint"/><mxPoint x="1331" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-35" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1331" y="830" as="sourcePoint"/><mxPoint x="1331" y="856" as="targetPoint"/><Array as="points"><mxPoint x="1365" y="830"/><mxPoint x="1365" y="856"/></Array></mxGeometry></mxCell><mxCell id="p1-36" value="rowToAccount → Money.of, Account.rehydrate" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1371" y="826" width="170" height="34" as="geometry"/></mxCell><mxCell id="p1-37" value="Account" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint x="1319" y="886" as="sourcePoint"/><mxPoint x="1156" y="886" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-38" value="11. await · COMMIT" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-18" relative="1" as="geometry"><mxPoint x="1156" y="940" as="sourcePoint"/><mxPoint x="1494" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-39" value="Account (await xong)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint x="1144" y="990" as="sourcePoint"/><mxPoint x="981" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-40" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="981" y="1020" as="sourcePoint"/><mxPoint x="981" y="1046" as="targetPoint"/><Array as="points"><mxPoint x="1015" y="1020"/><mxPoint x="1015" y="1046"/></Array></mxGeometry></mxCell><mxCell id="p1-41" value="12. toWalletView(account)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1021" y="1016" width="200" height="34" as="geometry"/></mxCell><mxCell id="p1-42" value="13. WalletView" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint x="969" y="1090" as="sourcePoint"/><mxPoint x="806" y="1090" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-43" value="trả giá trị (promise resolved)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-14" relative="1" as="geometry"><mxPoint x="794" y="1140" as="sourcePoint"/><mxPoint x="281" y="1140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-44" value="14. 200 {customerId, currency, balance, createdAt} + x-correlation-id" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-18" relative="1" as="geometry"><mxPoint x="269" y="1190" as="sourcePoint"/><mxPoint x="106" y="1190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-45" value="Gateway/Client: gửi header &lt;b&gt;x-tenant-id&lt;/b&gt;, &lt;b&gt;x-customer-id&lt;/b&gt; (gateway đặt), &lt;b&gt;x-correlation-id&lt;/b&gt; (tùy chọn)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="18" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-46" value="Fastify nhận HTTP; Nest điều phối middleware → guard → controller và đóng gói JSON. &lt;i&gt;Bên trong Nest: chưa đọc source [GIẢ THUYẾT].&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="193" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-47" value="Nhận hoặc sinh correlation id (chỉ nhận UUID hợp lệ), đặt vào response header, bọc phần còn lại trong AsyncLocalStorage để log tự gắn id." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="368" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-48" value="Lấy tenant và customer từ header do gateway đặt (không từ body/query). Thiếu/sai → ném lỗi, AllExceptionsFilter đổi thành mã lỗi (bỏ qua ở mức 1)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="543" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-49" value="Điểm vào HTTP của use case: chuyển caller cho GetWallet. Không có logic nghiệp vụ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-50" value="Use case: tính walletId, đọc ví trong 1 transaction, ném WalletNotFoundError nếu không có, trả WalletView." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="893" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-51" value="Mở 1 transaction SQL, gắn schema t_&amp;lt;tenant&amp;gt;, dựng bộ repository; commit khi xong, rollback nếu lỗi." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1068" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-52" value="SELECT tài khoản theo id (không khóa), đổi hàng thành Account (domain); bigint về dạng chuỗi qua toSafeInteger." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1243" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-53" value="Ngoài process. Kết nối lấy từ pool tarn (min 0, tối đa 10) qua tedious." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1418" y="1270" width="164" height="130" as="geometry"/></mxCell><mxCell id="p1-54" value="&lt;b&gt;Số mũi tên → hàm → file:dòng&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Hàm / component&lt;/th&gt;&lt;th&gt;Gọi tiếp&lt;/th&gt;&lt;th&gt;file:dòng&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Client → Fastify&lt;/td&gt;&lt;td&gt;GET /wallet&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;CorrelationMiddleware.use&lt;/td&gt;&lt;td&gt;resolveCorrelationId, runWithCorrelation&lt;/td&gt;&lt;td&gt;correlation.middleware.ts:11-15 · observability/correlation.ts:17, :9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;CallerGuard.canActivate&lt;/td&gt;&lt;td&gt;ConfigTenantRegistry.resolve (→ TenantId.parse), CustomerId.parse&lt;/td&gt;&lt;td&gt;caller.guard.ts:30-37 · tenant-registry.ts:13 · tenant-id.ts:9 · customer-id.ts:8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;WalletsController.get&lt;/td&gt;&lt;td&gt;gọi GetWallet.execute&lt;/td&gt;&lt;td&gt;wallets.controller.ts:42-45&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;GetWallet.execute&lt;/td&gt;&lt;td&gt;Account.walletId&lt;/td&gt;&lt;td&gt;get-wallet.ts:11-14 · account.ts:27&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;KyselyTenantUnitOfWork.run&lt;/td&gt;&lt;td&gt;schemaName, assertSchemaName, db.transaction().execute, trx.withSchema&lt;/td&gt;&lt;td&gt;unit-of-work.ts:22-25 · schema-name.ts:6, :11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;BEGIN (await · I/O)&lt;/td&gt;&lt;td&gt;Kysely → pool tarn → tedious → SQL Server&lt;/td&gt;&lt;td&gt;unit-of-work.ts:24 · database/connection.ts:16&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;work → accounts.find&lt;/td&gt;&lt;td&gt;callback do GetWallet truyền vào&lt;/td&gt;&lt;td&gt;get-wallet.ts:12-14 · account.repository.ts:16&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;SELECT (await · I/O)&lt;/td&gt;&lt;td&gt;selectFrom(accounts).where(id).executeTakeFirst&lt;/td&gt;&lt;td&gt;account.repository.ts:17-21&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;rowToAccount&lt;/td&gt;&lt;td&gt;toSafeInteger, Money.of, Account.rehydrate&lt;/td&gt;&lt;td&gt;mappers.ts:26 · database/numbers.ts:5 · money/money.ts:12 · account.ts:47&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;COMMIT (await · I/O)&lt;/td&gt;&lt;td&gt;kết thúc transaction().execute&lt;/td&gt;&lt;td&gt;unit-of-work.ts:24-40&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;toWalletView&lt;/td&gt;&lt;td&gt;Account.toProps&lt;/td&gt;&lt;td&gt;get-wallet.ts:15-16 · views.ts:12 · account.ts:98&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13-14&lt;/td&gt;&lt;td&gt;Controller trả → Nest → Client&lt;/td&gt;&lt;td&gt;Nest đóng gói JSON, thêm x-correlation-id (đã đặt ở bước 2)&lt;/td&gt;&lt;td&gt;correlation.middleware.ts:13&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Bao nhiêu hàm?&lt;/b&gt; Với một request thành công, lab đo bằng bộ đếm V8 (&lt;i&gt;Profiler.takePreciseCoverage&lt;/i&gt;) &lt;b&gt;14 hàm của repo&lt;/b&gt; được gọi: use, resolveCorrelationId, runWithCorrelation, canActivate, ConfigTenantRegistry.resolve, TenantId.parse, CustomerId.parse, WalletsController.get, GetWallet.execute, Account.walletId, toWalletView, Account.toProps, Account.rehydrate, Money.of [ĐÃ CHẠY, lab dùng DB giả]. Cộng &lt;b&gt;6 hàm lớp DB&lt;/b&gt; mà lab không đo được vì dùng DB giả (KyselyTenantUnitOfWork.run, schemaName, assertSchemaName, KyselyAccountRepository.find, rowToAccount, toSafeInteger; đọc từ code, [CHƯA CHẠY với SQL Server thật]) ⇒ &lt;b&gt;khoảng 20 hàm của repo&lt;/b&gt;, chưa tính hàm bên trong Fastify, Nest, Kysely, tedious." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="1100" height="520" as="geometry"/></mxCell><mxCell id="p1-55" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="1420" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1-56" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="1446" width="18" height="14" as="geometry"/></mxCell><mxCell id="p1-57" value="Framework (Nest/Fastify)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1442" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1-58" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1200" y="1470" width="18" height="14" as="geometry"/></mxCell><mxCell id="p1-59" value="interface (HTTP)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1466" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1-60" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="1494" width="18" height="14" as="geometry"/></mxCell><mxCell id="p1-61" value="application (use case)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1490" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1-62" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1200" y="1518" width="18" height="14" as="geometry"/></mxCell><mxCell id="p1-63" value="infrastructure (DB)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1514" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1-64" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1200" y="1542" width="18" height="14" as="geometry"/></mxCell><mxCell id="p1-65" value="Ngoài process (SQL Server)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1224" y="1538" width="220" height="20" as="geometry"/></mxCell><mxCell id="p1-66" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1206" y="1578" as="sourcePoint"/><mxPoint x="1254" y="1578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-67" value="Gọi đồng bộ (chạy tiếp ngay, cùng luồng JS)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="1568" width="260" height="20" as="geometry"/></mxCell><mxCell id="p1-68" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1206" y="1604" as="sourcePoint"/><mxPoint x="1254" y="1604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-69" value="await / I/O: nhường event loop, request khác được chạy" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="1594" width="300" height="20" as="geometry"/></mxCell><mxCell id="p1-70" value="" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1254" y="1630" as="sourcePoint"/><mxPoint x="1206" y="1630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-71" value="Giá trị trả về / tiếp tục sau await (microtask)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="1620" width="280" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Hai request chồng nhau" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2-2" value="&lt;b&gt;GET /wallet: request B đến khi request A chưa xong (cùng endpoint, cùng lúc)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="p2-3" value="Bằng chứng: lab &lt;i&gt;labs/get-wallet-http-trace.ts&lt;/i&gt; [ĐÃ CHẠY] dùng NestJS + Fastify + GetWallet thật, DB giả có độ trễ (BEGIN 20ms, SELECT 30ms, COMMIT 10ms). Request A (customer c1, id aaaaaaaa) và B (customer c2, id bbbbbbbb) gửi cùng lúc." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1100" height="40" as="geometry"/></mxCell><mxCell id="p2-4" value="&lt;b&gt;Client A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /wallet (c1)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="150" height="900" as="geometry"/></mxCell><mxCell id="p2-5" value="&lt;b&gt;Client B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /wallet (c2)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="100" width="150" height="900" as="geometry"/></mxCell><mxCell id="p2-6" value="&lt;b&gt;Nest + Fastify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;event loop · MỘT luồng JS&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="150" height="900" as="geometry"/></mxCell><mxCell id="p2-7" value="&lt;b&gt;Code wallet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;middleware → guard → controller → GetWallet → uow.run&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="605" y="100" width="190" height="900" as="geometry"/></mxCell><mxCell id="p2-8" value="&lt;b&gt;Pool kết nối&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tarn · min 0, max 10&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="855" y="100" width="150" height="900" as="geometry"/></mxCell><mxCell id="p2-9" value="&lt;b&gt;SQL Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ngoài process&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1055" y="100" width="150" height="900" as="geometry"/></mxCell><mxCell id="p2-10" value="A1. GET /wallet" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="106" y="200" as="sourcePoint"/><mxPoint x="474" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-11" value="B1. GET /wallet (gần như cùng lúc)" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="245" as="sourcePoint"/><mxPoint x="474" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-12" value="A2. chạy ĐỒNG BỘ tới await đầu tiên" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="486" y="300" as="sourcePoint"/><mxPoint x="694" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-13" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="694" y="294" width="12" height="42" as="geometry"/></mxCell><mxCell id="p2-14" value="A3. await · BEGIN → xin kết nối" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="706" y="336" as="sourcePoint"/><mxPoint x="924" y="336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-15" value="B2. chạy ĐỒNG BỘ (chỉ khi A đã nhường)" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="486" y="390" as="sourcePoint"/><mxPoint x="694" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-16" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="694" y="384" width="12" height="42" as="geometry"/></mxCell><mxCell id="p2-17" value="B3. await · BEGIN → xin kết nối" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="706" y="426" as="sourcePoint"/><mxPoint x="924" y="426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-18" value="par" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1230" height="450" as="geometry"/></mxCell><mxCell id="p2-19" value="&lt;b&gt;A&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="498" width="60" height="20" as="geometry"/></mxCell><mxCell id="p2-20" value="A4. BEGIN · SELECT wallet:c1 · COMMIT (await ×3)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="936" y="520" as="sourcePoint"/><mxPoint x="1124" y="520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-21" value="A5. xong (callback → microtask)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1124" y="580" as="sourcePoint"/><mxPoint x="706" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-22" value="A6. 200 (x-correlation-id = aaaaaaaa)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="694" y="640" as="sourcePoint"/><mxPoint x="106" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-23" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="690" as="sourcePoint"/><mxPoint x="1270" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-24" value="&lt;b&gt;B&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="56" y="700" width="60" height="20" as="geometry"/></mxCell><mxCell id="p2-25" value="B4. BEGIN · SELECT wallet:c2 · COMMIT (await ×3, xen kẽ với A)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="936" y="745" as="sourcePoint"/><mxPoint x="1124" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-26" value="B5. xong (callback → microtask)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1124" y="805" as="sourcePoint"/><mxPoint x="706" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-27" value="B6. 200 (x-correlation-id = bbbbbbbb)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="694" y="865" as="sourcePoint"/><mxPoint x="296" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-28" value="Client A: gửi request và chờ response của chính nó." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="15" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-29" value="Client B: gửi request thứ hai khi A chưa xong; không bị chặn bởi A." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="205" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-30" value="Một event loop, một luồng JS: chạy lần lượt phần ĐỒNG BỘ của A rồi của B; chỉ chuyển sang request khác tại điểm await." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-31" value="Code của repo (xem trang 1). Mỗi request có ngữ cảnh AsyncLocalStorage, transaction và đối tượng repository RIÊNG." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="615" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-32" value="Kysely MssqlDialect + tarn: min 0, tối đa &lt;b&gt;10&lt;/b&gt; kết nối (database/connection.ts:16)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="845" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-33" value="Xử lý hai transaction song song trên hai kết nối." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1045" y="1020" width="170" height="120" as="geometry"/></mxCell><mxCell id="p2-34" value="&lt;b&gt;Một luồng JS&lt;/b&gt;&lt;br&gt;Phần đồng bộ của B không chạy khi A đang chạy đồng bộ. B chỉ được chạy khi A gặp &lt;i&gt;await&lt;/i&gt; và nhường. Lab: cả A và B vào guard trong 1ms, vào BEGIN trong 1ms, rồi chờ I/O song song." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="100" width="340" height="120" as="geometry"/></mxCell><mxCell id="p2-35" value="&lt;b&gt;Thời gian&lt;/b&gt;&lt;br&gt;Lab [ĐÃ CHẠY]: hai request chồng nhau xong trong ~65ms, bằng một request tuần tự (~60ms DB giả), không phải ~120ms." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="230" width="340" height="80" as="geometry"/></mxCell><mxCell id="p2-36" value="&lt;b&gt;Ngữ cảnh riêng từng request&lt;/b&gt;&lt;br&gt;Lab: log của A luôn mang correlation &lt;b&gt;aaaaaaaa&lt;/b&gt;, của B luôn &lt;b&gt;bbbbbbbb&lt;/b&gt;, dù xen kẽ qua mọi await (AsyncLocalStorage, observability/correlation.ts:7)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="320" width="340" height="90" as="geometry"/></mxCell><mxCell id="p2-37" value="&lt;b&gt;Pool kết nối&lt;/b&gt;&lt;br&gt;tarn: min 0, max = &lt;i&gt;config.poolMax ?? 10&lt;/i&gt; (packages/database/src/connection.ts:16). &lt;i&gt;poolMax&lt;/i&gt; chỉ được đặt trong test (perf, chaos); service dùng mặc định: tests/chaos/support/service-config.test.ts:28 (&quot;poolMax không có biến môi trường&quot;) ⇒ tối đa &lt;b&gt;10&lt;/b&gt; kết nối. Comment repo tests/perf/support/perf-env.ts:167-168: vượt poolMax thì &quot;thời gian chờ pool bị tính vào độ trễ&quot; ⇒ request thứ 11 đồng thời phải &lt;b&gt;chờ&lt;/b&gt; kết nối rảnh. &lt;b&gt;[GIẢ THUYẾT]&lt;/b&gt; timeout của tarn chưa đọc, chưa chạy với SQL Server thật." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="420" width="340" height="190" as="geometry"/></mxCell><mxCell id="p2-38" value="&lt;b&gt;Khóa&lt;/b&gt;&lt;br&gt;GET /wallet chỉ SELECT, không updlock (account.repository.ts:16-23) ⇒ ứng dụng không giữ khóa; mỗi request vẫn mở transaction riêng (unit-of-work.ts:24). Nếu một thao tác GHI cùng ví đang giữ khóa, SELECT có thể phải chờ tùy mức cô lập. &lt;b&gt;[GIẢ THUYẾT]&lt;/b&gt; mức cô lập SQL Server chưa tìm thấy trong code." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="620" width="340" height="150" as="geometry"/></mxCell><mxCell id="p2-39" value="&lt;b&gt;Idempotency&lt;/b&gt;&lt;br&gt;GET không dùng idempotency key; hai request giống nhau chạy độc lập. (Idempotency chỉ áp dụng cho endpoint ghi, ví dụ POST /topups.)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1320" y="780" width="340" height="90" as="geometry"/></mxCell><mxCell id="p2-40" value="&lt;b&gt;Vết chạy lab (rút gọn)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;+207ms A guard · +208ms B guard&lt;br&gt;+208ms A GetWallet, A BEGIN&lt;br&gt;+208ms B GetWallet, B BEGIN&lt;br&gt;+229ms A SELECT · +229ms B SELECT&lt;br&gt;+269ms A COMMIT → +270ms A 200&lt;br&gt;+270ms B COMMIT → +271ms B 200&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320" y="880" width="340" height="140" as="geometry"/></mxCell><mxCell id="p2-41" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2-42" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1216" width="18" height="14" as="geometry"/></mxCell><mxCell id="p2-43" value="Framework (Nest/Fastify)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="1212" width="220" height="20" as="geometry"/></mxCell><mxCell id="p2-44" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="18" height="14" as="geometry"/></mxCell><mxCell id="p2-45" value="interface (HTTP)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="1236" width="220" height="20" as="geometry"/></mxCell><mxCell id="p2-46" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="1264" width="18" height="14" as="geometry"/></mxCell><mxCell id="p2-47" value="application (use case)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="1260" width="220" height="20" as="geometry"/></mxCell><mxCell id="p2-48" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="1288" width="18" height="14" as="geometry"/></mxCell><mxCell id="p2-49" value="infrastructure (DB)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="1284" width="220" height="20" as="geometry"/></mxCell><mxCell id="p2-50" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="1312" width="18" height="14" as="geometry"/></mxCell><mxCell id="p2-51" value="Ngoài process (SQL Server)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="1308" width="220" height="20" as="geometry"/></mxCell><mxCell id="p2-52" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="46" y="1348" as="sourcePoint"/><mxPoint x="94" y="1348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-53" value="Gọi đồng bộ (chạy tiếp ngay, cùng luồng JS)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="1338" width="260" height="20" as="geometry"/></mxCell><mxCell id="p2-54" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="46" y="1374" as="sourcePoint"/><mxPoint x="94" y="1374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-55" value="await / I/O: nhường event loop, request khác được chạy" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="1364" width="300" height="20" as="geometry"/></mxCell><mxCell id="p2-56" value="" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="94" y="1400" as="sourcePoint"/><mxPoint x="46" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-57" value="Giá trị trả về / tiếp tục sau await (microtask)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="1390" width="280" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
