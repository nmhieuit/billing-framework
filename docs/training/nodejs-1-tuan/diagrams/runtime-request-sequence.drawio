                </mxCell>
                <mxCell id="p2-30" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Một event loop, một luồng JS: chạy lần lượt phần ĐỒNG BỘ của A rồi của B; chỉ chuyển sang request khác tại điểm await." vertex="1">
