                </mxCell>
                <mxCell id="s3-55" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="AbortSignal.timeout hủy fetch; mọi lỗi mạng/5xx/timeout → &quot;unavailable&quot; (4xx trừ 408/429 → &quot;rejected&quot;)." vertex="1">
