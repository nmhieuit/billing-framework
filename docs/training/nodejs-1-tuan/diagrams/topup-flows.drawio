<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0"><diagram name="1. Happy case" id="s1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="2250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1-2" value="&lt;b&gt;Nạp tiền (top-up): happy case, wallet → payment → webhook → ghi sổ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="s1-3" value="Số trong ngoặc &lt;b&gt;(n)&lt;/b&gt; khớp bảng cuối trang. Mũi tên cam = await/I/O (nhường event loop). Bằng chứng chạy: &lt;i&gt;labs/topup-async-flow.ts&lt;/i&gt; [ĐÃ CHẠY] (client nhận 202 trước khi payment trả lời). Các bước payment worker và webhook đọc từ code, [CHƯA CHẠY với SQL Server/Docker thật]." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1750" height="40" as="geometry"/></mxCell><mxCell id="s1-4" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gọi API&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-5" value="&lt;b&gt;TopupsController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interface · topups.controller.ts:42&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-6" value="&lt;b&gt;RequestTopup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;application · request-topup.ts:42&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="375" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-7" value="&lt;b&gt;Wallet DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SQL Server · schema t_&amp;lt;tenant&amp;gt;&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-8" value="&lt;b&gt;InlineTopupSubmitter + SubmitTopup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;application · inline-topup-submitter.ts:14 · submit-topup.ts:42&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-9" value="&lt;b&gt;HttpPaymentGateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;infrastructure · http-payment-gateway.ts:19&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-10" value="&lt;b&gt;Payment HTTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;charges.route.ts:19 + CreateCharge&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-11" value="&lt;b&gt;Payment DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SQL Server · billing_payment&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-12" value="&lt;b&gt;Payment Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CompleteDueCharges · DeliverDueWebhooks&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1425" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-13" value="&lt;b&gt;Wallet Webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;webhooks.controller.ts:34 + ApplyPaymentResult&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="100" width="150" height="1230" as="geometry"/></mxCell><mxCell id="s1-14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="175" as="sourcePoint"/><mxPoint x="1780" y="175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-15" value="&lt;b&gt;A. Request đồng bộ: client chờ tới khi nhận 202&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="44" y="177" width="700" height="20" as="geometry"/></mxCell><mxCell id="s1-16" value="(1) POST /topups  {amount}  + Idempotency-Key, x-tenant-id, x-customer-id" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="150" y="-16" relative="1" as="geometry"><mxPoint x="106" y="225" as="sourcePoint"/><mxPoint x="269" y="225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-17" value="(2) execute({tenant, customerId, key, amount})" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="281" y="275" as="sourcePoint"/><mxPoint x="444" y="275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-18" value="(3) await · 1 transaction: find ví · find key · insert topup · save key → REQUESTED" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="456" y="325" as="sourcePoint"/><mxPoint x="619" y="325" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-19" value="(4) submitSoon(tenant, topupId)  — KHÔNG await" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="456" y="375" as="sourcePoint"/><mxPoint x="794" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-20" value="{status:202, body:{topupId}}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="444" y="425" as="sourcePoint"/><mxPoint x="281" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-21" value="202 Accepted {topupId, status:REQUESTED}  ← client xong tại đây" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="269" y="465" as="sourcePoint"/><mxPoint x="106" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-22" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="495" as="sourcePoint"/><mxPoint x="1780" y="495" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-23" value="&lt;b&gt;B. Chạy nền không chờ: wallet gọi payment (phần đồng bộ của submitSoon chạy NGAY, phần sau await chạy nền)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="44" y="497" width="700" height="20" as="geometry"/></mxCell><mxCell id="s1-24" value="(5) await · lockById + claim: next_attempt_at = now + 60s (lease)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="794" y="545" as="sourcePoint"/><mxPoint x="631" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-25" value="(6) createCharge({key topup:&amp;lt;tenant&amp;gt;:&amp;lt;topupId&amp;gt;, reference=topupId, metadata.tenantId})" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="806" y="595" as="sourcePoint"/><mxPoint x="969" y="595" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-26" value="(7) await · POST /charges  (idempotency-key; AbortSignal.timeout 5000ms)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="981" y="645" as="sourcePoint"/><mxPoint x="1144" y="645" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-27" value="(8) await · idempotency.find(null) · Charge.create(PENDING, dueAt) · insert · save key" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1156" y="695" as="sourcePoint"/><mxPoint x="1319" y="695" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-28" value="202 {chargeId}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1144" y="745" as="sourcePoint"/><mxPoint x="981" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-29" value="{kind:'created', chargeId}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="969" y="785" as="sourcePoint"/><mxPoint x="806" y="785" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-30" value="(9) await · recordSubmitted(chargeId): status PENDING, attempts 1, next_attempt_at null" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="794" y="835" as="sourcePoint"/><mxPoint x="631" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-31" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="870" as="sourcePoint"/><mxPoint x="1780" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-32" value="&lt;b&gt;C. Worker payment (setTimeout, mỗi WORKER_INTERVAL_MS) hoàn tất charge và gửi webhook về wallet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="44" y="872" width="700" height="20" as="geometry"/></mxCell><mxCell id="s1-33" value="(10) await · CompleteDueCharges: lockDue · charge.complete → SUCCEEDED · webhooks.add(PENDING)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="-20" y="-16" relative="1" as="geometry"><mxPoint x="1494" y="920" as="sourcePoint"/><mxPoint x="1331" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-34" value="(11) await · POST /webhooks/payment  (x-signature, x-webhook-event-id)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1506" y="970" as="sourcePoint"/><mxPoint x="1669" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-35" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1681" y="1005" as="sourcePoint"/><mxPoint x="1681" y="1031" as="targetPoint"/><Array as="points"><mxPoint x="1715" y="1005"/><mxPoint x="1715" y="1031"/></Array></mxGeometry></mxCell><mxCell id="s1-36" value="(12) verify chữ ký · validate · tenant" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1721" y="1001" width="200" height="34" as="geometry"/></mxCell><mxCell id="s1-37" value="(13) await · ApplyPaymentResult: inbox.record · lockById · lockMany(ví, GATEWAY) · saveBalance×2 · ledger.post · save → SUCCEEDED" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="-40" y="-16" relative="1" as="geometry"><mxPoint x="1669" y="1075" as="sourcePoint"/><mxPoint x="631" y="1075" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-38" value="200 {outcome:&quot;APPLIED&quot;}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1669" y="1125" as="sourcePoint"/><mxPoint x="1506" y="1125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-39" value="(14) await · webhook recordSuccess → DELIVERED + ghi webhook_attempts" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="-20" y="-16" relative="1" as="geometry"><mxPoint x="1494" y="1175" as="sourcePoint"/><mxPoint x="1331" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-40" value="Chỉ chờ tới khi nhận 202 (xong sau bước 4), không chờ payment." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="18" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-41" value="Đọc header, kiểm Idempotency-Key, gọi use case; trả 202 (HttpCode 202)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="193" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-42" value="Tạo topup REQUESTED và lưu idempotency trong MỘT transaction; sau commit mới gọi submitSoon (chỉ lần tạo mới)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="368" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-43" value="topups, idempotency_keys, accounts, ledger_*, processed_messages (inbox) của tenant." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="543" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-44" value="submitSoon: bắn rồi quên, có .catch/.finally. SubmitTopup: chiếm (lease) → gọi payment NGOÀI transaction → ghi kết quả." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="718" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-45" value="Gọi HTTP POST /charges, hạn chót PAYMENT_TIMEOUT_MS (mặc định 5000); đổi kết quả thành created / rejected / unavailable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="893" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-46" value="POST /charges: kiểm header, CreateCharge (idempotent theo key), trả 202 + chargeId." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1068" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-47" value="charges, idempotency_keys, webhook_events, webhook_attempts." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1243" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-48" value="Một Worker 2 việc mỗi tick: hoàn tất charge đến hạn, gửi webhook đến hạn (gửi HTTP ngoài transaction)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1418" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-49" value="Kiểm chữ ký, lấy tenant từ metadata ĐÃ KÝ, ApplyPaymentResult ghi sổ kép topup:&amp;lt;id&amp;gt; (idempotent)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1593" y="1360" width="164" height="120" as="geometry"/></mxCell><mxCell id="s1-50" value="&lt;b&gt;Số → hàm → file:dòng → trạng thái dữ liệu&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Hàm / component&lt;/th&gt;&lt;th&gt;Gọi tiếp&lt;/th&gt;&lt;th&gt;file:dòng&lt;/th&gt;&lt;th&gt;Trạng thái dữ liệu sau bước&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;TopupsController.create&lt;/td&gt;&lt;td&gt;readIdempotencyKey, CallerGuard&lt;/td&gt;&lt;td&gt;topups.controller.ts:42-57 · caller.guard.ts:30&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;RequestTopup.execute&lt;/td&gt;&lt;td&gt;attempt(): uow.run&lt;/td&gt;&lt;td&gt;request-topup.ts:42-43&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;uow.run (1 transaction)&lt;/td&gt;&lt;td&gt;accounts.find · idempotency.find · Topup.request · topups.insert · idempotency.save&lt;/td&gt;&lt;td&gt;request-topup.ts:44-75 · topup.ts:32-58&lt;/td&gt;&lt;td&gt;topups: &lt;b&gt;REQUESTED&lt;/b&gt;, attempts 0, next_attempt_at = now&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;InlineTopupSubmitter.submitSoon&lt;/td&gt;&lt;td&gt;async IIFE → SubmitTopup.executeFor (.catch/.finally)&lt;/td&gt;&lt;td&gt;request-topup.ts:88 · inline-topup-submitter.ts:14-32&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;SubmitTopup.executeFor&lt;/td&gt;&lt;td&gt;topups.lockById, Topup.claim (lease 60s)&lt;/td&gt;&lt;td&gt;submit-topup.ts:42-52 · topup.ts:73-76&lt;/td&gt;&lt;td&gt;next_attempt_at = now + 60s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;SubmitTopup.submitClaimed&lt;/td&gt;&lt;td&gt;gateway.createCharge&lt;/td&gt;&lt;td&gt;submit-topup.ts:66-73&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;HttpPaymentGateway.createCharge&lt;/td&gt;&lt;td&gt;fetch POST /charges, AbortSignal.timeout&lt;/td&gt;&lt;td&gt;http-payment-gateway.ts:19-35&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;charges.route POST /charges → CreateCharge.execute&lt;/td&gt;&lt;td&gt;idempotency.find · Charge.create · charges.insert · idempotency.save&lt;/td&gt;&lt;td&gt;charges.route.ts:19-66 · create-charge.ts:33-81 · charge.ts:26-53&lt;/td&gt;&lt;td&gt;charges: &lt;b&gt;PENDING&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;SubmitTopup.submitClaimed (ghi kết quả)&lt;/td&gt;&lt;td&gt;topups.lockById, recordSubmitted&lt;/td&gt;&lt;td&gt;submit-topup.ts:76-84 · topup.ts:78-87&lt;/td&gt;&lt;td&gt;topups: &lt;b&gt;PENDING&lt;/b&gt;, charge_id, attempts 1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;CompleteDueCharges.execute&lt;/td&gt;&lt;td&gt;charges.lockDue · Charge.complete · WebhookEvent.forCharge&lt;/td&gt;&lt;td&gt;complete-due-charges.ts:22-37 · charge.ts:63-77 · webhook-event.ts:26-59&lt;/td&gt;&lt;td&gt;charges: &lt;b&gt;SUCCEEDED&lt;/b&gt;; webhook_events: &lt;b&gt;PENDING&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;11&lt;/td&gt;&lt;td&gt;DeliverDueWebhooks.execute → HttpWebhookSender.send&lt;/td&gt;&lt;td&gt;lockDue + claim (lease) → gửi NGOÀI transaction&lt;/td&gt;&lt;td&gt;deliver-due-webhooks.ts:43-61 · http-webhook-sender.ts:17-39 · payment/bootstrap.ts:68-76&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;12&lt;/td&gt;&lt;td&gt;WebhooksController.receive&lt;/td&gt;&lt;td&gt;verifyWebhook · validateChargeWebhook · registry.resolve&lt;/td&gt;&lt;td&gt;webhooks.controller.ts:34-67&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;13&lt;/td&gt;&lt;td&gt;ApplyPaymentResult.execute → apply&lt;/td&gt;&lt;td&gt;inbox.record · lockMany · saveBalance · LedgerTransaction.topup · ledger.post · topups.save&lt;/td&gt;&lt;td&gt;apply-payment-result.ts:60-139 · ledger-transaction.ts:74-96&lt;/td&gt;&lt;td&gt;ví &lt;b&gt;+amount&lt;/b&gt;, GATEWAY −amount; ledger &lt;code&gt;topup:&amp;lt;topupId&amp;gt;&lt;/code&gt;; topups: &lt;b&gt;SUCCEEDED&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;14&lt;/td&gt;&lt;td&gt;DeliverDueWebhooks (ghi kết quả)&lt;/td&gt;&lt;td&gt;WebhookEvent.recordSuccess, webhooks.recordAttempt&lt;/td&gt;&lt;td&gt;deliver-due-webhooks.ts:63-78 · webhook-event.ts:79-88&lt;/td&gt;&lt;td&gt;webhook_events: &lt;b&gt;DELIVERED&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Điều cần nhớ&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Client nhận &lt;b&gt;202 ngay sau commit&lt;/b&gt; (bước 3-4); tiền chỉ vào ví ở bước 13, sau webhook.&lt;/li&gt;&lt;li&gt;Bước 5-9 chạy &lt;b&gt;nền&lt;/b&gt;: lỗi ở đây không làm hỏng request (có .catch); topup vẫn REQUESTED và Worker gửi lại (xem sheet 3).&lt;/li&gt;&lt;li&gt;Hai lần gọi HTTP đều nằm &lt;b&gt;ngoài transaction&lt;/b&gt; DB (không giữ khóa trong lúc chờ mạng).&lt;/li&gt;&lt;li&gt;Correlation id &lt;b&gt;không&lt;/b&gt; được truyền từ wallet sang payment, cũng không có trong webhook.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="1380" height="560" as="geometry"/></mxCell><mxCell id="s1-51" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="1560" width="200" height="20" as="geometry"/></mxCell><mxCell id="s1-52" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="1586" width="18" height="14" as="geometry"/></mxCell><mxCell id="s1-53" value="Framework (Nest/Fastify)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1582" width="220" height="20" as="geometry"/></mxCell><mxCell id="s1-54" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="1610" width="18" height="14" as="geometry"/></mxCell><mxCell id="s1-55" value="interface (HTTP)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1606" width="220" height="20" as="geometry"/></mxCell><mxCell id="s1-56" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="1634" width="18" height="14" as="geometry"/></mxCell><mxCell id="s1-57" value="application (use case)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1630" width="220" height="20" as="geometry"/></mxCell><mxCell id="s1-58" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="1658" width="18" height="14" as="geometry"/></mxCell><mxCell id="s1-59" value="infrastructure (DB)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1654" width="220" height="20" as="geometry"/></mxCell><mxCell id="s1-60" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1480" y="1682" width="18" height="14" as="geometry"/></mxCell><mxCell id="s1-61" value="Ngoài process (SQL Server)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1678" width="220" height="20" as="geometry"/></mxCell><mxCell id="s1-62" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1486" y="1718" as="sourcePoint"/><mxPoint x="1534" y="1718" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-63" value="Gọi đồng bộ (chạy tiếp ngay, cùng luồng JS)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1708" width="260" height="20" as="geometry"/></mxCell><mxCell id="s1-64" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1486" y="1744" as="sourcePoint"/><mxPoint x="1534" y="1744" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-65" value="await / I/O: nhường event loop, request khác được chạy" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1734" width="300" height="20" as="geometry"/></mxCell><mxCell id="s1-66" value="" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1534" y="1770" as="sourcePoint"/><mxPoint x="1486" y="1770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1-67" value="Giá trị trả về / tiếp tục sau await (microtask)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="1760" width="280" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Bị trùng" id="s2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s2-2" value="&lt;b&gt;Nạp tiền bị trùng: 5 tình huống và lớp chặn trùng tương ứng&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="s2-3" value="Bằng chứng chạy: &lt;i&gt;labs/topup-duplicates.ts&lt;/i&gt; [ĐÃ CHẠY] dùng code thật RequestTopup, CreateCharge, ApplyPaymentResult với DB giả có rollback. Chaos đối chiếu: tests/chaos/scenarios-payment-crash.chaos.test.ts (S6 :284, S8 :378). [CHƯA CHẠY với SQL Server thật]" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1850" height="40" as="geometry"/></mxCell><mxCell id="s2-4" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gọi POST /topups&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-5" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TopupsController + RequestTopup&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-6" value="&lt;b&gt;Wallet DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;idempotency_keys · topups · processed_messages&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-7" value="&lt;b&gt;HttpPaymentGateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;wallet → payment&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-8" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;charges.route + CreateCharge&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-9" value="&lt;b&gt;Payment DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;idempotency_keys · charges&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-10" value="&lt;b&gt;Payment Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DeliverDueWebhooks&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-11" value="&lt;b&gt;Wallet Webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;WebhooksController + ApplyPaymentResult&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="100" width="150" height="1760" as="geometry"/></mxCell><mxCell id="s2-12" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="1480" height="250" as="geometry"/></mxCell><mxCell id="s2-13" value="&lt;b&gt;2.1  Gửi lại CÙNG Idempotency-Key (tuần tự)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="178" width="1300" height="20" as="geometry"/></mxCell><mxCell id="s2-14" value="&lt;b&gt;Lab 1a [ĐÃ CHẠY]&lt;/b&gt;&lt;br&gt;lần 1: replayed=false, topupId=tp_1&lt;br&gt;lần 2: replayed=true, topupId=tp_1&lt;br&gt;submitSoon = 1 lần; topup trong DB = 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chặn bằng&lt;/b&gt;: PK (customer_id, idempotency_key) + so requestHash. &lt;i&gt;request-topup.ts:53-54, 92-103&lt;/i&gt;. Không gọi payment lần 2 (request-topup.ts:88)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="175" width="370" height="250" as="geometry"/></mxCell><mxCell id="s2-15" value="(A1) POST /topups  (cùng key, cùng amount)" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="106" y="235" as="sourcePoint"/><mxPoint x="284" y="235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-16" value="(A2) await · find ví · idempotency.find(customer, key) → ĐÃ CÓ" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="285" as="sourcePoint"/><mxPoint x="474" y="285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-17" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="296" y="315" as="sourcePoint"/><mxPoint x="296" y="341" as="targetPoint"/><Array as="points"><mxPoint x="330" y="315"/><mxPoint x="330" y="341"/></Array></mxGeometry></mxCell><mxCell id="s2-18" value="(A3) replay(): requestHash khớp → trả body cũ, replayed=true" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="336" y="311" width="330" height="34" as="geometry"/></mxCell><mxCell id="s2-19" value="(A4) 202 {topupId cũ} — KHÔNG gọi submitSoon" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="284" y="385" as="sourcePoint"/><mxPoint x="106" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-20" value="par" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="1480" height="400" as="geometry"/></mxCell><mxCell id="s2-21" value="&lt;b&gt;2.2  HAI request đồng thời cùng key (đua)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="448" width="1300" height="20" as="geometry"/></mxCell><mxCell id="s2-22" value="&lt;b&gt;Lab 1b [ĐÃ CHẠY]&lt;/b&gt;&lt;br&gt;A: replayed=false, topupId=tp_1&lt;br&gt;B: replayed=true, topupId=tp_1&lt;br&gt;uow.run = 3 lần (2 request + 1 lần thử lại của bên thua); submitSoon = 1; topup trong DB = 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chặn bằng&lt;/b&gt;: khóa chính ném DuplicateKeyError; giao dịch của bên thua ROLLBACK, &lt;i&gt;attempt()&lt;/i&gt; chạy lại đúng 1 lần. &lt;i&gt;request-topup.ts:78-86&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="445" width="370" height="400" as="geometry"/></mxCell><mxCell id="s2-23" value="(B1) Request A và B cùng key, gần như cùng lúc" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="106" y="505" as="sourcePoint"/><mxPoint x="284" y="505" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-24" value="(B2) await · A và B cùng đọc: CHƯA có key" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="555" as="sourcePoint"/><mxPoint x="474" y="555" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-25" value="(B3) await · A: insert topup + save key → COMMIT" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="605" as="sourcePoint"/><mxPoint x="474" y="605" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-26" value="(B4) B: save key → DuplicateKeyError → ROLLBACK (không để lại topup mồ côi)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="474" y="655" as="sourcePoint"/><mxPoint x="296" y="655" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-27" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="296" y="685" as="sourcePoint"/><mxPoint x="296" y="711" as="targetPoint"/><Array as="points"><mxPoint x="330" y="685"/><mxPoint x="330" y="711"/></Array></mxGeometry></mxCell><mxCell id="s2-28" value="(B5) B bắt DuplicateKeyError, chạy attempt() lần 2" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="336" y="681" width="330" height="34" as="geometry"/></mxCell><mxCell id="s2-29" value="(B6) await · B lần 2: thấy key của A → replay" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="745" as="sourcePoint"/><mxPoint x="474" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-30" value="(B7) A: 202 (submitSoon 1 lần) · B: 202 replayed=true" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="284" y="800" as="sourcePoint"/><mxPoint x="106" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-31" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="1480" height="215" as="geometry"/></mxCell><mxCell id="s2-32" value="&lt;b&gt;2.3  CÙNG key nhưng NỘI DUNG KHÁC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="868" width="1300" height="20" as="geometry"/></mxCell><mxCell id="s2-33" value="&lt;b&gt;Lab 1c [ĐÃ CHẠY]&lt;/b&gt;&lt;br&gt;IdempotencyConflictError: Idempotency-Key &quot;k-3&quot; was already used with different content.&lt;br&gt;&lt;br&gt;&lt;b&gt;HTTP&lt;/b&gt;: 422 IDEMPOTENCY_KEY_REUSED (&lt;i&gt;wallet interface/http/errors.ts:86-90&lt;/i&gt;). Không ghi gì, không gọi payment." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="865" width="370" height="215" as="geometry"/></mxCell><mxCell id="s2-34" value="(C1) POST /topups  (cùng key, amount KHÁC)" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="106" y="925" as="sourcePoint"/><mxPoint x="284" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-35" value="(C2) await · idempotency.find → có; requestHash KHÁC" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="296" y="975" as="sourcePoint"/><mxPoint x="474" y="975" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-36" value="(C3) 422 IDEMPOTENCY_KEY_REUSED" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="284" y="1035" as="sourcePoint"/><mxPoint x="106" y="1035" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-37" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1480" height="270" as="geometry"/></mxCell><mxCell id="s2-38" value="&lt;b&gt;2.4  Wallet gửi lại POST /charges cùng key (phản hồi lần 1 bị mất, hoặc retry)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1103" width="1300" height="20" as="geometry"/></mxCell><mxCell id="s2-39" value="&lt;b&gt;Lab 2 [ĐÃ CHẠY]&lt;/b&gt;&lt;br&gt;lần 1: replayed=false, chargeId=ch_1, 202&lt;br&gt;lần 2: replayed=true, chargeId=ch_1, 202&lt;br&gt;số charge được tạo = 1&lt;br&gt;cùng key, amount khác: IdempotencyConflictError.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chặn bằng&lt;/b&gt;: idempotency_keys của payment theo key &lt;code&gt;topup:&amp;lt;tenant&amp;gt;:&amp;lt;topupId&amp;gt;&lt;/code&gt; (submit-topup.ts:69). Chaos S6 &quot;response is lost&quot; xác nhận: một charge." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="1100" width="370" height="270" as="geometry"/></mxCell><mxCell id="s2-40" value="(D1) await · POST /charges lần 2 (cùng idempotency-key)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="676" y="1160" as="sourcePoint"/><mxPoint x="854" y="1160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-41" value="(D2) await · idempotency.find(key) → ĐÃ CÓ" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="866" y="1210" as="sourcePoint"/><mxPoint x="1044" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-42" value="(D3) 202 {chargeId cũ} — replay, KHÔNG tạo charge mới (create-charge.ts:54, 93-104)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="60" y="-16" relative="1" as="geometry"><mxPoint x="854" y="1260" as="sourcePoint"/><mxPoint x="676" y="1260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-43" value="(D4) nếu nội dung KHÁC: 422 IDEMPOTENCY_KEY_REUSED (create-charge.ts:93-97)" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="60" y="-16" relative="1" as="geometry"><mxPoint x="854" y="1320" as="sourcePoint"/><mxPoint x="676" y="1320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-44" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=0;collapsible=0;width=70;height=24;fillColor=none;strokeColor=#333333;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1480" height="400" as="geometry"/></mxCell><mxCell id="s2-45" value="&lt;b&gt;2.5  Webhook giao HAI LẦN (cùng eventId)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="1393" width="1300" height="20" as="geometry"/></mxCell><mxCell id="s2-46" value="&lt;b&gt;Lab 3 [ĐÃ CHẠY]&lt;/b&gt;&lt;br&gt;lần 1: APPLIED · lần 2: DUPLICATE&lt;br&gt;số dư ví = 50000; giao dịch sổ cái = 1 (topup:tp_9); topup = SUCCEEDED; không có log bất thường.&lt;br&gt;&lt;br&gt;&lt;b&gt;3 lớp chặn&lt;/b&gt; (lớp 2 và 3 đọc từ code, [CHƯA CHẠY riêng]):&lt;br&gt;1) inbox (consumer, eventId): &lt;i&gt;apply-payment-result.ts:100, 67-76&lt;/i&gt;&lt;br&gt;2) trạng thái topup đã SUCCEEDED → StateTransitionError → IGNORED (&lt;i&gt;:112-113, 141-150&lt;/i&gt;)&lt;br&gt;3) UNIQUE business_key &lt;code&gt;topup:&amp;lt;id&amp;gt;&lt;/code&gt; (&lt;i&gt;ledger-transaction.ts:87&lt;/i&gt;).&lt;br&gt;Nguồn lần 2: payment gửi lại khi không nhận 2xx, hoặc kịch bản webhook=duplicate (deliver-due-webhooks.ts:92-94)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="1390" width="370" height="400" as="geometry"/></mxCell><mxCell id="s2-47" value="(E1) POST /webhooks/payment  (eventId evt-1) — lần 1" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1246" y="1450" as="sourcePoint"/><mxPoint x="1424" y="1450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-48" value="(E2) await · inbox.record + ghi sổ topup:&amp;lt;id&amp;gt; → APPLIED, SUCCEEDED" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1424" y="1500" as="sourcePoint"/><mxPoint x="486" y="1500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-49" value="(E3) POST /webhooks/payment  (cùng eventId evt-1) — lần 2" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1246" y="1550" as="sourcePoint"/><mxPoint x="1424" y="1550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-50" value="(E4) await · inbox.record → DuplicateKeyError(inbox) → ROLLBACK" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1424" y="1600" as="sourcePoint"/><mxPoint x="486" y="1600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-51" value="(E5) 200 {outcome:&quot;DUPLICATE&quot;} — số dư và sổ cái KHÔNG đổi" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1424" y="1660" as="sourcePoint"/><mxPoint x="1246" y="1660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-52" value="Gửi POST /topups; client có thể gửi lại do timeout mạng hoặc bấm hai lần." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="15" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-53" value="Controller + RequestTopup: kiểm key, tạo topup một lần; replay không gửi lại sang payment." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="205" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-54" value="PK (customer_id, idempotency_key); inbox PK (consumer, message_id); ledger UNIQUE business_key." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-55" value="Gửi idempotency-key cố định topup:&amp;lt;tenant&amp;gt;:&amp;lt;topupId&amp;gt; nên gọi lại luôn an toàn." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="585" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-56" value="CreateCharge: replay trả bản cũ; khác nội dung → 422." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="775" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-57" value="idempotency_keys(key) → charge_id; charges.reference = topupId." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="965" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-58" value="Gửi webhook, retry theo WEBHOOK_BACKOFF nếu không nhận 2xx." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1155" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-59" value="Chặn webhook trùng bằng inbox, rồi trạng thái topup, rồi UNIQUE sổ cái." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1345" y="1880" width="170" height="120" as="geometry"/></mxCell><mxCell id="s2-60" value="&lt;b&gt;Tóm tắt: cơ chế chặn trùng và hậu quả&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Tình huống&lt;/th&gt;&lt;th&gt;Cơ chế chặn&lt;/th&gt;&lt;th&gt;Client / bên gọi thấy&lt;/th&gt;&lt;th&gt;Gửi lại sang payment?&lt;/th&gt;&lt;th&gt;Ghi sổ lần hai?&lt;/th&gt;&lt;th&gt;file:dòng&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.1&lt;/td&gt;&lt;td&gt;Gửi lại cùng key (tuần tự)&lt;/td&gt;&lt;td&gt;idempotency_keys PK + requestHash&lt;/td&gt;&lt;td&gt;202, topupId cũ, replayed=true&lt;/td&gt;&lt;td&gt;Không&lt;/td&gt;&lt;td&gt;Không&lt;/td&gt;&lt;td&gt;request-topup.ts:53-54, 92-103&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.2&lt;/td&gt;&lt;td&gt;2 request đồng thời cùng key&lt;/td&gt;&lt;td&gt;PK ném DuplicateKeyError, rollback, thử lại 1 lần&lt;/td&gt;&lt;td&gt;202 cho cả hai, cùng topupId&lt;/td&gt;&lt;td&gt;Không (1 lần)&lt;/td&gt;&lt;td&gt;Không&lt;/td&gt;&lt;td&gt;request-topup.ts:78-86&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.3&lt;/td&gt;&lt;td&gt;Cùng key, nội dung khác&lt;/td&gt;&lt;td&gt;so requestHash&lt;/td&gt;&lt;td&gt;422 IDEMPOTENCY_KEY_REUSED&lt;/td&gt;&lt;td&gt;Không&lt;/td&gt;&lt;td&gt;Không&lt;/td&gt;&lt;td&gt;request-topup.ts:93-96 · errors.ts:86-90&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.4&lt;/td&gt;&lt;td&gt;Gọi lại POST /charges cùng key&lt;/td&gt;&lt;td&gt;idempotency_keys payment&lt;/td&gt;&lt;td&gt;202 chargeId cũ (hoặc 422 nếu khác nội dung)&lt;/td&gt;&lt;td&gt;n/a&lt;/td&gt;&lt;td&gt;Không (1 charge)&lt;/td&gt;&lt;td&gt;create-charge.ts:53-54, 93-104&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2.5&lt;/td&gt;&lt;td&gt;Webhook 2 lần&lt;/td&gt;&lt;td&gt;inbox → trạng thái topup → UNIQUE sổ cái&lt;/td&gt;&lt;td&gt;200 DUPLICATE&lt;/td&gt;&lt;td&gt;n/a&lt;/td&gt;&lt;td&gt;Không (1 giao dịch)&lt;/td&gt;&lt;td&gt;apply-payment-result.ts:67-76, 100&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Điều cần nhớ&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Mọi lớp chặn trùng dựa vào &lt;b&gt;ràng buộc duy nhất của DB&lt;/b&gt; trong cùng transaction, không dựa vào bộ nhớ process.&lt;/li&gt;&lt;li&gt;Bên thua cuộc đua bị &lt;b&gt;rollback hoàn toàn&lt;/b&gt; (không để lại topup mồ côi) rồi thấy kết quả của bên thắng.&lt;/li&gt;&lt;li&gt;Webhook trùng vẫn được trả &lt;b&gt;200&lt;/b&gt; để payment ngừng gửi lại.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="2040" width="1850" height="380" as="geometry"/></mxCell><mxCell id="s2-61" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2450" width="200" height="20" as="geometry"/></mxCell><mxCell id="s2-62" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="2476" width="18" height="14" as="geometry"/></mxCell><mxCell id="s2-63" value="Framework (Nest/Fastify)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="2472" width="220" height="20" as="geometry"/></mxCell><mxCell id="s2-64" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="2500" width="18" height="14" as="geometry"/></mxCell><mxCell id="s2-65" value="interface (HTTP)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="2496" width="220" height="20" as="geometry"/></mxCell><mxCell id="s2-66" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="2524" width="18" height="14" as="geometry"/></mxCell><mxCell id="s2-67" value="application (use case)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="2520" width="220" height="20" as="geometry"/></mxCell><mxCell id="s2-68" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="2548" width="18" height="14" as="geometry"/></mxCell><mxCell id="s2-69" value="infrastructure (DB)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="2544" width="220" height="20" as="geometry"/></mxCell><mxCell id="s2-70" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="2572" width="18" height="14" as="geometry"/></mxCell><mxCell id="s2-71" value="Ngoài process (SQL Server)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="64" y="2568" width="220" height="20" as="geometry"/></mxCell><mxCell id="s2-72" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="46" y="2608" as="sourcePoint"/><mxPoint x="94" y="2608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-73" value="Gọi đồng bộ (chạy tiếp ngay, cùng luồng JS)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="2598" width="260" height="20" as="geometry"/></mxCell><mxCell id="s2-74" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="46" y="2634" as="sourcePoint"/><mxPoint x="94" y="2634" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-75" value="await / I/O: nhường event loop, request khác được chạy" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="2624" width="300" height="20" as="geometry"/></mxCell><mxCell id="s2-76" value="" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="94" y="2660" as="sourcePoint"/><mxPoint x="46" y="2660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2-77" value="Giá trị trả về / tiếp tục sau await (microtask)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="2650" width="280" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Payment chậm, retry, circuit breaker" id="s3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s3-2" value="&lt;b&gt;Nạp tiền khi payment phản hồi chậm: timeout → retry theo bậc backoff → FAILED (và circuit breaker)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="s3-3" value="Bằng chứng chạy: &lt;i&gt;labs/topup-slow-payment-retry.ts&lt;/i&gt; [ĐÃ CHẠY] dùng code thật HttpPaymentGateway (fetch bị treo, hủy bởi AbortSignal.timeout), SubmitTopup, Topup. Đồng hồ nhảy tới next_attempt_at; timeout rút xuống 200ms. [CHƯA CHẠY với SQL Server/Docker thật]" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1850" height="40" as="geometry"/></mxCell><mxCell id="s3-4" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /topups&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="25" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-5" value="&lt;b&gt;Wallet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TopupsController + RequestTopup&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-6" value="&lt;b&gt;Wallet DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;topups (status, attempts, next_attempt_at)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-7" value="&lt;b&gt;SubmitTopup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;submitSoon (lần đầu) · Worker tick (retry)&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="595" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-8" value="&lt;b&gt;HttpPaymentGateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;timeout PAYMENT_TIMEOUT_MS = 5000&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-9" value="&lt;b&gt;Payment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CHẬM / không trả lời&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="975" y="100" width="150" height="1680" as="geometry"/></mxCell><mxCell id="s3-10" value="&lt;b&gt;Payment Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CompleteDueCharges · webhook&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=