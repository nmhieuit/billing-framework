ff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="676" y="955" as="sourcePoint"/><mxPoint x="854" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-32" value="(13) await · POST /charges  (timeout 5000ms)" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="866" y="1005" as="sourcePoint"/><mxPoint x="1044" y="1005" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-33" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1045" as="sourcePoint"/><mxPoint x="1500" y="1045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-34" value="&lt;b&gt;alt 1: payment VẪN chậm, lần thất bại thứ n ≤ 5&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1048" width="800" height="20" as="geometry"/></mxCell><mxCell id="s3-35" value="(14a) recordUnavailable → RETRY_SCHEDULED: next_attempt_at = +1s, +5s, +30s, +120s, +600s" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="664" y="1100" as="sourcePoint"/><mxPoint x="486" y="1100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-36" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1135" as="sourcePoint"/><mxPoint x="1500" y="1135" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-37" value="&lt;b&gt;alt 2: lần thất bại thứ 6 (hết 5 bậc backoff)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1138" width="800" height="20" as="geometry"/></mxCell><mxCell id="s3-38" value="(14b) recordUnavailable → status FAILED, failure_code PAYMENT_UNAVAILABLE, completed_at; log error" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="664" y="1190" as="sourcePoint"/><mxPoint x="486" y="1190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-39" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1225" as="sourcePoint"/><mxPoint x="1500" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-40" value="&lt;b&gt;alt 3: payment hồi phục (trả 202 {chargeId})&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1228" width="800" height="20" as="geometry"/></mxCell><mxCell id="s3-41" value="(14c) 202 {chargeId}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1044" y="1280" as="sourcePoint"/><mxPoint x="866" y="1280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-42" value="(15c) await · recordSubmitted: status PENDING, charge_id, next_attempt_at null → như happy case" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="664" y="1330" as="sourcePoint"/><mxPoint x="486" y="1330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-43" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#333333;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1375" as="sourcePoint"/><mxPoint x="1500" y="1375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-44" value="&lt;b&gt;alt 4: payment từ chối rõ ràng (4xx, trừ 408/429)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1378" width="800" height="20" as="geometry"/></mxCell><mxCell id="s3-45" value="(14d) recordRejected → FAILED, PAYMENT_REJECTED, KHÔNG retry" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="664" y="1430" as="sourcePoint"/><mxPoint x="486" y="1430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-46" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="1510" as="sourcePoint"/><mxPoint x="1520" y="1510" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-47" value="&lt;b&gt;B. Charge vẫn thành công: webhook đến MUỘN sau khi topup đã FAILED&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="44" y="1512" width="700" height="20" as="geometry"/></mxCell><mxCell id="s3-48" value="(16) POST /webhooks/payment: charge.succeeded (muộn)" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1246" y="1570" as="sourcePoint"/><mxPoint x="1424" y="1570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-49" value="(17) await · applySucceeded: FAILED(PAYMENT_UNAVAILABLE) → SUCCEEDED, ghi sổ topup:&amp;lt;id&amp;gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1424" y="1620" as="sourcePoint"/><mxPoint x="486" y="1620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-50" value="200 {outcome:&quot;APPLIED&quot;}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="1424" y="1670" as="sourcePoint"/><mxPoint x="1246" y="1670" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-51" value="Luôn nhận 202 nhanh: payment chậm KHÔNG làm chậm request." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="15" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-52" value="RequestTopup commit rồi submitSoon (nền)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="205" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-53" value="Trạng thái retry nằm trong DB: status, attempts, next_attempt_at (sống sót khi wallet restart)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="395" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-54" value="Một đường code cho cả lần gửi đầu và retry: chiếm (lease) → gọi payment ngoài transaction → ghi kết quả." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="585" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-55" value="AbortSignal.timeout hủy fetch; mọi lỗi mạng/5xx/timeout → &quot;unavailable&quot; (4xx trừ 408/429 → &quot;rejected&quot;)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="775" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-56" value="Phía bị chậm. Wallet KHÔNG gửi X-Simulate nên không thể gây chậm qua wallet." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="965" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-57" value="Nếu charge đã tạo thì vẫn hoàn tất và gửi webhook về wallet." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1155" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-58" value="Chấp nhận thành công muộn (cổng thanh toán là nguồn sự thật)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1345" y="1790" width="170" height="120" as="geometry"/></mxCell><mxCell id="s3-59" value="&lt;b&gt;KHÔNG CÓ CIRCUIT BREAKER TRONG CODE&lt;/b&gt;&lt;br&gt;[ĐÃ CHẠY] &lt;code&gt;grep -riE &quot;circuit|breaker&quot;&lt;/code&gt; trên mã nguồn, tài liệu, compose, JSON: 0 kết quả.&lt;br&gt;Thứ có thật: timeout (&lt;i&gt;http-payment-gateway.ts:34&lt;/i&gt;), retry theo bậc backoff (&lt;i&gt;topup.ts:102-117&lt;/i&gt;, mặc định 1,5,30,120,600 giây: &lt;i&gt;config.ts:41&lt;/i&gt;), lease 60s (&lt;i&gt;submit-topup.ts:16&lt;/i&gt;), FAILED khi hết bậc, nhận webhook thành công muộn (&lt;i&gt;topup.ts:119-125&lt;/i&gt;).&lt;br&gt;Hệ quả: mỗi topup tự retry ĐỘC LẬP; khi payment chết, mọi topup vẫn mỗi lần chờ đủ timeout rồi mới thất bại (không có cơ chế &quot;ngắt nhanh&quot; dùng chung)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="175" width="370" height="260" as="geometry"/></mxCell><mxCell id="s3-60" value="&lt;b&gt;Lab [ĐÃ CHẠY]: dãy retry khi payment luôn chậm&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;Lần gọi&lt;/th&gt;&lt;th&gt;Đồng hồ&lt;/th&gt;&lt;th&gt;Kết quả&lt;/th&gt;&lt;th&gt;attempts&lt;/th&gt;&lt;th&gt;next_attempt_at&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;+0s&lt;/td&gt;&lt;td&gt;RETRY_SCHEDULED&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;+1s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;+1s&lt;/td&gt;&lt;td&gt;RETRY_SCHEDULED&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;+6s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;+6s&lt;/td&gt;&lt;td&gt;RETRY_SCHEDULED&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;+36s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;+36s&lt;/td&gt;&lt;td&gt;RETRY_SCHEDULED&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;+156s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;+156s&lt;/td&gt;&lt;td&gt;RETRY_SCHEDULED&lt;/td&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;+756s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;+756s&lt;/td&gt;&lt;td&gt;&lt;b&gt;FAILED&lt;/b&gt; (PAYMENT_UNAVAILABLE)&lt;/td&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;null&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;Mỗi lần gọi mất ≈ đúng timeout (lab 200ms; thật 5000ms). Trong lúc chờ: status=REQUESTED, next_attempt_at = +60s (lease).&lt;br&gt;&lt;b&gt;Ước tính&lt;/b&gt; thời gian tới FAILED ≈ 756s + 6×5s ≈ 786s (khoảng 13 phút) &lt;b&gt;[GIẢ THUYẾT: ước tính từ lab, chưa đo với Docker]&lt;/b&gt;.&lt;br&gt;Webhook thành công muộn sau FAILED: FAILED → SUCCEEDED. Hồi phục ở lần 3: SUBMITTED → PENDING, attempts 3." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="450" width="370" height="400" as="geometry"/></mxCell><mxCell id="s3-61" value="&lt;b&gt;Lease 60s &amp;gt; timeout 5s&lt;/b&gt;&lt;br&gt;Khi một lần gọi đang chờ payment, topup được &quot;giữ chỗ&quot; (next_attempt_at = +60s) nên Worker không gửi trùng song song; idempotency key cố định giúp gọi lại luôn an toàn (sheet 2, mục 2.4).&lt;br&gt;&lt;br&gt;&lt;b&gt;Đối chiếu chaos&lt;/b&gt;: scenarios-payment-crash.chaos.test.ts S6 :202 (503 rồi timeout → retry theo backoff, 1 charge, ghi có 1 lần), :247, :284." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="870" width="370" height="200" as="geometry"/></mxCell><mxCell id="s3-62" value="&lt;b&gt;Cách tạo &quot;payment chậm&quot; khi debug [CHƯA CHẠY]&lt;/b&gt;&lt;br&gt;1) &lt;code&gt;docker compose -f deploy/compose.local.yml -f deploy/compose.debug.yml --env-file deploy/.env pause payment&lt;/code&gt;&lt;br&gt;2) POST /topups, quan sát topups: attempts tăng, next_attempt_at dời.&lt;br&gt;3) &lt;code&gt;... unpause payment&lt;/code&gt; để hồi phục.&lt;br&gt;Không dùng được X-Simulate qua wallet (wallet không gửi header này)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1600" y="1090" width="370" height="190" as="geometry"/></mxCell><mxCell id="s3-63" value="&lt;b&gt;Số → hàm → file:dòng&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;#&lt;/th&gt;&lt;th&gt;Hàm / component&lt;/th&gt;&lt;th&gt;file:dòng&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;TopupsController.create → RequestTopup.execute&lt;/td&gt;&lt;td&gt;topups.controller.ts:42-57 · request-topup.ts:42-88&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2-3&lt;/td&gt;&lt;td&gt;uow.run: Topup.request, insert; trả 202&lt;/td&gt;&lt;td&gt;request-topup.ts:44-75 · topup.ts:32-58&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4-5&lt;/td&gt;&lt;td&gt;submitSoon → SubmitTopup.executeFor (lease)&lt;/td&gt;&lt;td&gt;inline-topup-submitter.ts:14-32 · submit-topup.ts:42-52 · topup.ts:73-76&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6-8&lt;/td&gt;&lt;td&gt;createCharge → fetch + AbortSignal.timeout → catch → unavailable&lt;/td&gt;&lt;td&gt;submit-topup.ts:66-73 · http-payment-gateway.ts:19-35, 62-64&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9, 14a, 14b&lt;/td&gt;&lt;td&gt;Topup.recordUnavailable (backoff / FAILED)&lt;/td&gt;&lt;td&gt;topup.ts:102-117 · submit-topup.ts:91-96, 122-126&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;Worker tick → SubmitDueTopups → executeNextDue; Topup.isDue&lt;/td&gt;&lt;td&gt;wallet/bootstrap.ts:212-226, 259-264 · submit-due-topups.ts:35 · submit-topup.ts:55-64 · topup.ts:64-70&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;14c-15c&lt;/td&gt;&lt;td&gt;recordSubmitted (PENDING)&lt;/td&gt;&lt;td&gt;submit-topup.ts:82-84 · topup.ts:78-87&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;14d&lt;/td&gt;&lt;td&gt;recordRejected (4xx, không retry)&lt;/td&gt;&lt;td&gt;submit-topup.ts:85-90 · http-payment-gateway.ts:49-60 · topup.ts:89-99&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;16-17&lt;/td&gt;&lt;td&gt;webhook muộn: WebhooksController → ApplyPaymentResult → Topup.applySucceeded&lt;/td&gt;&lt;td&gt;webhooks.controller.ts:69 · apply-payment-result.ts:112-137 · topup.ts:119-134&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Điều cần nhớ&lt;/b&gt;&lt;ul&gt;&lt;li&gt;Client nhận &lt;b&gt;202&lt;/b&gt; ngay; mọi thứ về payment chậm xảy ra &lt;b&gt;nền&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;Trạng thái retry nằm trong &lt;b&gt;DB&lt;/b&gt; (status, attempts, next_attempt_at): wallet restart không mất lịch retry.&lt;/li&gt;&lt;li&gt;Hết bậc → &lt;b&gt;FAILED&lt;/b&gt; nhưng vẫn &lt;b&gt;có thể SUCCEEDED&lt;/b&gt; nếu webhook đến muộn; đối soát hằng ngày bắt các ca còn lệch.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Chưa có circuit breaker&lt;/b&gt;: hướng cải tiến nếu cần phải được thiết kế và duyệt riêng (ngoài phạm vi sơ đồ này).&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1930" width="1380" height="440" as="geometry"/></mxCell><mxCell id="s3-64" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="1950" width="200" height="20" as="geometry"/></mxCell><mxCell id="s3-65" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1480" y="1976" width="18" height="14" as="geometry"/></mxCell><mxCell id="s3-66" value="Framework (Nest/Fastify)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1972" width="220" height="20" as="geometry"/></mxCell><mxCell id="s3-67" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1480" y="2000" width="18" height="14" as="geometry"/></mxCell><mxCell id="s3-68" value="interface (HTTP)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="1996" width="220" height="20" as="geometry"/></mxCell><mxCell id="s3-69" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1480" y="2024" width="18" height="14" as="geometry"/></mxCell><mxCell id="s3-70" value="application (use case)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="2020" width="220" height="20" as="geometry"/></mxCell><mxCell id="s3-71" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1480" y="2048" width="18" height="14" as="geometry"/></mxCell><mxCell id="s3-72" value="infrastructure (DB)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="2044" width="220" height="20" as="geometry"/></mxCell><mxCell id="s3-73" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1480" y="2072" width="18" height="14" as="geometry"/></mxCell><mxCell id="s3-74" value="Ngoài process (SQL Server)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1504" y="2068" width="220" height="20" as="geometry"/></mxCell><mxCell id="s3-75" value="" style="html=1;endArrow