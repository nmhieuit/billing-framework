x="0" y="-16" relative="1" as="geometry"><mxPoint x="866" y="525" as="sourcePoint"/><mxPoint x="1044" y="525" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-21" value="Payment chậm / treo: không trả lời&lt;br&gt;(demo: &lt;code&gt;docker compose pause payment&lt;/code&gt;) [CHƯA CHẠY]" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="970" y="545" width="160" height="70" as="geometry"/></mxCell><mxCell id="s3-22" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#1a4d8f;strokeWidth=2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="866" y="620" as="sourcePoint"/><mxPoint x="866" y="646" as="targetPoint"/><Array as="points"><mxPoint x="900" y="620"/><mxPoint x="900" y="646"/></Array></mxGeometry></mxCell><mxCell id="s3-23" value="(8) sau 5000ms AbortSignal hủy → catch → {kind:&quot;unavailable&quot;}" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="906" y="616" width="330" height="34" as="geometry"/></mxCell><mxCell id="s3-24" value="{kind:&quot;unavailable&quot;, error}" style="html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="854" y="685" as="sourcePoint"/><mxPoint x="676" y="685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3-25" value="(9) await · recordUnavailable: attempts+1, next_attempt_at = now + backoff[n-1], status VẪN REQUESTED" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=3;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;edgeStyle=none;" edge="1" parent="1"><mxGeometry x="0" y="-16" relative="1" as="geometry"><mxPoint x="664" y="735" as=