                <mxCell id="s3-56" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" value="Phía bị chậm. Wallet KHÔNG gửi X-Simulate nên không thể gây chậm qua wallet." vertex="1">
