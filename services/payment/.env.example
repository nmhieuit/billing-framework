# Kết nối SQL Server (DB billing_payment đã được tạo bởi deploy/compose.billing.yml)
PAYMENT_DB_HOST=
PAYMENT_DB_PORT=1433
PAYMENT_DB_NAME=billing_payment
PAYMENT_DB_USER=billing_payment_app
PAYMENT_DB_PASSWORD=

# Endpoint của wallet nhận webhook và khóa ký HMAC (không có giá trị mặc định)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Tùy chọn (giá trị mặc định ghi bên cạnh)
PORT=3002
WEBHOOK_BACKOFF=1,5,30,120,600
WORKER_INTERVAL_MS=500
RESPONSE_TIMEOUT_MS=30000

# Dọn dữ liệu (retention): mặc định BẬT nhưng chạy thử (chỉ đếm và log). Đặt RETENTION_DRY_RUN=false để xóa thật.
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
RETENTION_INTERVAL_MINUTES=60
RETENTION_MAX_SECONDS_PER_RUN=60
RETENTION_BATCH_SIZE=1000
RETENTION_WEBHOOK_DAYS=30
RETENTION_IDEMPOTENCY_KEYS_DAYS=90

# Metric OpenTelemetry (tùy chọn): không đặt OTEL_EXPORTER_OTLP_ENDPOINT thì không xuất metric
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=payment
METRICS_SAMPLE_INTERVAL_SECONDS=15

# Tài khoản có quyền db_owner chỉ dùng cho `corepack pnpm db:migrate:payment` (không dùng khi chạy service)
PAYMENT_MIGRATOR_DB_USER=
PAYMENT_MIGRATOR_DB_PASSWORD=
