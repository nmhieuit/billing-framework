{
  "name": "billing-framework",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.integration.config.ts services/wallet/src/contract",
    "db:migrate:payment": "tsx db/payment/migrate.ts",
    "db:migrate:wallet": "tsx db/wallet/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "devDependencies": {
    "@billing/contracts": "workspace:^",
    "@billing/database": "workspace:^",
    "@billing/testing": "workspace:^",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "kysely": "^0.29.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
